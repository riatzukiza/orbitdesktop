{
  "name": "orbit-desktop",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "node scripts/isolated_build.mjs",
    "start": "node --experimental-strip-types server/index.mjs",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node scripts/generate-workspace-contract.mjs --check && node --experimental-strip-types scripts/generate-workbench-contract.mjs --check && npm run build && npm test",
    "format": "prettier --write src server tests docs README.md package.json index.html vite.config.js tsconfig.json"
  },
  "dependencies": {
    "@a2ui/lit": "0.12.0",
    "@a2ui/markdown-it": "0.2.0",
    "@a2ui/web_core": "0.12.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@excalidraw/excalidraw": "0.18.1",
    "@huggingface/transformers": "4.3.0",
    "@lexical/clipboard": "0.52.0",
    "@lexical/code": "0.52.0",
    "@lexical/history": "0.52.0",
    "@lexical/html": "0.52.0",
    "@lexical/link": "0.52.0",
    "@lexical/list": "0.52.0",
    "@lexical/markdown": "0.52.0",
    "@lexical/rich-text": "0.52.0",
    "@lexical/selection": "0.52.0",
    "@lexical/utils": "0.52.0",
    "@modelcontextprotocol/client": "2.2.0",
    "@modelcontextprotocol/core": "2.2.0",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "ajv": "8.20.0",
    "better-sqlite3": "12.11.1",
    "diff": "9.0.0",
    "dockview-core": "8.3.1",
    "highlight.js": "11.12.0",
    "lexical": "0.52.0",
    "node-pty": "^1.1.0",
    "openid-client": "6.8.8",
    "playwright-core": "1.58.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sqlite-vec": "0.1.9",
    "three": "^0.180.0",
    "ws": "^8.18.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.180.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
